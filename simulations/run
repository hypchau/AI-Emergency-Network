#!/bin/sh
# Command-line launcher (Linux/macOS/WSL/MinGW shell). Examples:
#   ./run -c QuickFlat                       # Qtenv if available
#   ./run -u Cmdenv -c FleetSweep            # batch
# INET location: INET_ROOT env variable (set by opp_env / INET setenv) or ../../inet-4.5.4
DIR=$(cd "$(dirname "$0")" && pwd)
INET=${INET_ROOT:-$DIR/../../inet-4.5.4}
EXE=$DIR/../src/aiensim
[ -x "$EXE" ] || EXE=$DIR/../src/aiensim_dbg
cd "$DIR" && exec "$EXE" -n "$DIR/../src:$DIR:$INET/src" --image-path="$DIR/../images" "$@"
